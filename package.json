{
  "name": "@pi-codeui/core",
  "version": "0.10.0",
  "description": "Git-aware, keyboard-first terminal UI for Pi Coding Agent",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "schemas",
    "themes",
    "docs/terminal-profiles.md",
    "docs/mockups/pi-codeui-terminal.png",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc",
    "test": "node --test test/*.test.ts",
    "dev": "pi -e ./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "themes": [
      "./themes/codeui-midnight.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
